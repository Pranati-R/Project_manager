{#- Rendered by generator.py. Every interpolated value goes through |tok, which refuses
    anything outside a small safe character set. -#}
{%- macro proxy_common(p, host_header) %}
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $gw_connection_upgrade;
        proxy_set_header Host {{ host_header }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
{%- if p.prefix != "/" %}
        proxy_set_header X-Forwarded-Prefix {{ p.prefix|tok }};
{%- endif %}
        proxy_set_header Cookie $gw_project_cookie;
        proxy_connect_timeout 5s;
        proxy_read_timeout {{ p.read_timeout|tok }}s;
        proxy_send_timeout {{ p.read_timeout|tok }}s;
{%- if p.max_body_size %}
        client_max_body_size {{ p.max_body_size|tok }};
{%- endif %}
{%- endmacro %}

{%- macro project_locations(p) %}
    # ── {{ p.id|tok }}{% if p.prefix != "/" %} ({{ p.prefix|tok }}){% endif %}: frontend {{ p.fe_hostport|tok }} [{{ p.fe_mode|tok }}]{% if p.api %}, api {{ p.api.hostport|tok }}{% endif %}
{%- if not p.enabled %}
    # disabled in the dashboard
    location = {{ p.prefix|tok }} {
        return 404;
    }
    location {{ p.fe_location|tok }} {
        return 404;
    }
{%- else %}
{%- if p.redirect_bare %}
    location = {{ p.prefix|tok }} {
        return 301 {{ p.prefix|tok }}/$is_args$args;
    }
{%- endif %}
{%- if p.api %}
    location = {{ p.api.location|tok }} {
        proxy_pass {{ p.api.pass_exact|tok }};
        proxy_buffering {{ "on" if p.api.buffering else "off" }};
{{- proxy_common(p, p.api.host_header) }}
    }
    location {{ p.api.location|tok }}/ {
        proxy_pass {{ p.api.pass_slash|tok }};
        proxy_buffering {{ "on" if p.api.buffering else "off" }};
{{- proxy_common(p, p.api.host_header) }}
    }
{%- endif %}
    location {{ p.fe_location|tok }} {
        proxy_pass {{ p.fe_pass|tok }};
{%- if p.fe_mode == "rewrite" %}
        # best-effort rewriting of root-absolute URLs (see docs/VITE_BASE_PATH.md)
        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        sub_filter_types text/css application/javascript text/javascript;
        sub_filter '="//' '="//';
        sub_filter "='//" "='//";
        sub_filter 'url(//' 'url(//';
        sub_filter '="/' '="{{ p.prefix|tok }}/';
        sub_filter "='/" "='{{ p.prefix|tok }}/";
        sub_filter 'url(/' 'url({{ p.prefix|tok }}/';
        sub_filter 'url("/' 'url("{{ p.prefix|tok }}/';
        sub_filter "url('/" "url('{{ p.prefix|tok }}/";
        sub_filter '"/assets/' '"{{ p.prefix|tok }}/assets/';
        proxy_redirect http://{{ p.fe_hostport|tok }}/ {{ p.prefix|tok }}/;
        proxy_redirect ~^/(.*)$ {{ p.prefix|tok }}/$1;
        proxy_cookie_path / {{ p.prefix|tok }}/;
{%- endif %}
{{- proxy_common(p, p.fe_host_header) }}
    }
{%- endif %}
{%- endmacro %}

{%- macro access_rules() %}
{%- for cidr in settings.allowed_cidrs %}
    allow {{ cidr|tok }};
{%- endfor %}
    deny all;
{%- endmacro %}

{%- macro listen(port) %}
{%- for addr in settings.listen_addresses %}
    listen {{ addr|listen_addr }}:{{ port|tok }};
{%- endfor %}
{%- endmacro -%}

# ─────────────────────────────────────────────────────────────────────────────
# Generated by nginx-gateway-manager {{ version|tok }}. DO NOT EDIT BY HAND:
# this file is rewritten whenever a change is applied from the dashboard.
# Only gw_-prefixed names and the servers below are defined here; nothing in this
# file changes how other nginx sites behave.
# ─────────────────────────────────────────────────────────────────────────────

map $http_upgrade $gw_connection_upgrade {
    default upgrade;
    ''      close;
}

# The dashboard session cookie is never forwarded to the projects
map $http_cookie $gw_project_cookie {
    default $http_cookie;
    "~^(?<gw_ck_a>(?:[^;]*;)*?)\s*gwm_session=[^;]*;?\s*(?<gw_ck_b>.*)$" "$gw_ck_a$gw_ck_b";
}

log_format gw_main '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent '
                   '"$http_referer" "$http_user_agent" rt=$request_time ua="$upstream_addr" '
                   'us=$upstream_status urt=$upstream_response_time';

# ── gateway: every project on one port ───────────────────────────────────────
server {
{{- listen(settings.gateway_port) }}
    server_name _;
    absolute_redirect off;
{{- access_rules() }}
    access_log {{ log_dir|tok }}/gateway-{{ settings.gateway_port|tok }}.access.log gw_main;
    error_log {{ log_dir|tok }}/gateway-{{ settings.gateway_port|tok }}.error.log warn;
    client_max_body_size {{ settings.client_max_body_size|tok }};

    location = /gateway-health {
        default_type text/plain;
        return 200 "ok\n";
    }
{%- if landing_html %}
    location = / {
        default_type text/html;
        return 200 "{{ landing_html }}";
    }
{%- endif %}
{% for p in path_projects %}
{{- project_locations(p) }}
{% endfor %}
{%- if root_project %}
{{- project_locations(root_project) }}
{%- else %}
    location / {
        return 404;
    }
{%- endif %}
}
{%- for p in port_projects %}

# ── {{ p.id|tok }}: served at the site root on its own port ──
server {
{{- listen(p.dedicated_port) }}
    server_name _;
    absolute_redirect off;
{{- access_rules() }}
    access_log {{ log_dir|tok }}/gateway-{{ p.id|tok }}.access.log gw_main;
    error_log {{ log_dir|tok }}/gateway-{{ p.id|tok }}.error.log warn;
    client_max_body_size {{ settings.client_max_body_size|tok }};
{{ project_locations(p) }}
}
{%- endfor %}
{%- if settings.admin_mode == "dedicated_port" %}

# ── dashboard: proxied to the manager on 127.0.0.1 ──
server {
{{- listen(settings.admin_port) }}
    server_name _;
    absolute_redirect off;
{{- access_rules() }}
    access_log {{ log_dir|tok }}/gateway-admin.access.log gw_main;
    error_log {{ log_dir|tok }}/gateway-admin.error.log warn;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:{{ manager_port|tok }};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
{%- endif %}
